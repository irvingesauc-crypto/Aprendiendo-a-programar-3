op=int(input("Ingrese un número del 1 al 3 para elegir una opción: 1. Ver productos, 2. Comprar productos, 3. Salir del programa: "))
Precio_Sable_de_Luz=1000
Precio_Arma=500
Precio_Tanque=2000
Precio_Escudo=800
while op==1:
    print("Ver productos.")
    print(f"1. Sable de Luz, precio: {Precio_Sable_de_Luz}")
    print(f"2. Arma, precio: {Precio_Arma}")
    print(f"3. Tanque, precio: {Precio_Tanque}")
    print(f"4. Escudo, precio: {Precio_Escudo}")
    print("Volver al menú principal ¿Si o NO? ")
    volver=input()
    if volver=="Si":
        op=int(input("Ingrese un número del 1 al 3 para elegir una opción: 1. Ver productos, 2. Comprar productos, 3. Salir del programa: "))
    else:
        op=3
