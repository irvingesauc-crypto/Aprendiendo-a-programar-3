    if producto==1:
        print(f"¿Cuántos Sables de Luz desea comprar? {cantidad}")
        Desea_comprar_otro_producto=input("¿Desea comprar otro producto? Si o No?")
        while Desea_comprar_otro_producto=="Si":
            producto=int(input("Ingrese el número del producto que desea comprar: "))
            cantidad=int(input("Ingrese la cantidad que desea comprar: "))
            Desea_comprar_otro_producto=input("¿Desea comprar otro producto? Si o No?")
    elif producto==2:
        print(f"¿Cuántas Armas desea comprar? {cantidad}")
        Desea_comprar_otro_producto=input("¿Desea comprar otro producto? Si o No?")
        while Desea_comprar_otro_producto=="Si":
            producto=int(input("Ingrese el número del producto que desea comprar: "))
            cantidad=int(input("Ingrese la cantidad que desea comprar: "))
            Desea_comprar_otro_producto=input("¿Desea comprar otro producto? Si o No?")
    elif producto==3:
        print(f"¿Cuántos Tanques desea comprar? {cantidad}")
        Desea_comprar_otro_producto=input("¿Desea comprar otro producto? Si o No?")
        while Desea_comprar_otro_producto=="Si":
            producto=int(input("Ingrese el número del producto que desea comprar: "))
            cantidad=int(input("Ingrese la cantidad que desea comprar: "))
            Desea_comprar_otro_producto=input("¿Desea comprar otro producto? Si o No?")
    elif producto==4:
        print(f"¿Cuántos Escudos desea comprar? {cantidad}")
        Desea_comprar_otro_producto=input("¿Desea comprar otro producto? Si o No?")
        while Desea_comprar_otro_producto=="Si":
            producto=int(input("Ingrese el número del producto que desea comprar: "))
            cantidad=int(input("Ingrese la cantidad que desea comprar: "))
            Desea_comprar_otro_producto=input("¿Desea comprar otro producto? Si o No?")
    else:
        print("Producto inválido.")
    Total=Precio_Sable_de_Luz*cantidad+Precio_Arma*cantidad+Precio_Tanque*cantidad+Precio_Escudo*cantidad
    print(f"Total a pagar: {Total}")
if op==3:
    print("Saliendo del programa.")